  create  table "shopsphere"."analytics"."category_revenue__dbt_tmp"
  
  
    as
  
  (
    select
    p.category,
    sum(f.quantity) as units_sold,
    sum(f.order_amount) as total_revenue
from "shopsphere"."analytics"."fact_orders" f
join "shopsphere"."analytics"."dim_product" p
    on f.product_id = p.product_id
group by p.category
order by total_revenue desc
  );
  
